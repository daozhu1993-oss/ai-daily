---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import DailyItemCard from '../../components/DailyItemCard.astro';
import EditorialHero from '../../components/EditorialHero.astro';
import EditorialCategoryBar from '../../components/EditorialCategoryBar.astro';
import { getCollection, render } from 'astro:content';
import { siteConfig } from '../../config/site';

export async function getStaticPaths() {
  const allDailies = await getCollection('daily', ({ data }) => !data.draft);

  const sortedDailies = allDailies.sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );

  return sortedDailies.map((issue) => {
    return {
      params: { date: issue.data.date },
      props: { issue, allIssues: sortedDailies },
    };
  });
}

const { issue, allIssues } = Astro.props;
const { date, title, highlights, items } = issue.data;
const displayTitle = title || `${date} · 今日看点`;
const { Content } = await render(issue);

// Sort items: pinned first
const sortedItems = [...items].sort((a, b) => {
  if (a.pinned && !b.pinned) return -1;
  if (!a.pinned && b.pinned) return 1;
  return 0;
});
---

<DashboardLayout
  currentIssue={issue}
  allIssues={allIssues}
  showRightSidebar={false}
  title={`${displayTitle} - ${siteConfig.name}`}
  description={highlights || `${date} AI 精选日报，共收录 ${items.length} 条高价值资讯与产品洞察。`}
>
  <div class="space-y-8 pb-20">
    <!-- 1. Cinematic Editorial Hero Stage (电影画报大刊头) -->
    <EditorialHero issue={issue} />

    <!-- 2. Sticky Magazine Category Filter Bar (吸顶分类分栏) -->
    <EditorialCategoryBar totalCount={sortedItems.length} />

    <!-- Optional Editor's Note Banner -->
    {Content && (
      <div class="p-5 rounded-2xl bg-zinc-100/80 dark:bg-zinc-900/60 border border-zinc-200/80 dark:border-zinc-800/80 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
        <Content />
      </div>
    )}

    <!-- 3. Cinematic 2-Column Screenplay Cards Feed (电影分镜画报流) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {sortedItems.map((item, idx) => (
        <DailyItemCard item={item} index={idx} />
      ))}
    </div>
  </div>
</DashboardLayout>
