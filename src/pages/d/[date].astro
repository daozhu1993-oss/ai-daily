---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import DailyItemCard from '../../components/DailyItemCard.astro';
import EditorialHero from '../../components/EditorialHero.astro';
import EditorialCategoryBar from '../../components/EditorialCategoryBar.astro';
import { getCollection, render } from 'astro:content';
import { siteConfig } from '../../config/site';

export async function getStaticPaths() {
  const allDailies = await getCollection('daily', ({ data }) => !data.draft);

  const sortedDailies = allDailies.sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );

  return sortedDailies.map((issue) => {
    return {
      params: { date: issue.data.date },
      props: { issue, allIssues: sortedDailies },
    };
  });
}

const { issue, allIssues } = Astro.props;
const { date, title, highlights, items } = issue.data;
const displayTitle = title || `${date} · 今日看点`;
const { Content } = await render(issue);

// Sort items: pinned first
const sortedItems = [...items].sort((a, b) => {
  if (a.pinned && !b.pinned) return -1;
  if (!a.pinned && b.pinned) return 1;
  return 0;
});
---

<DashboardLayout
  currentIssue={issue}
  allIssues={allIssues}
  showRightSidebar={false}
  title={`${displayTitle} - ${siteConfig.name}`}
  description={highlights || `${date} AI 精选日报，共收录 ${items.length} 条高价值资讯与产品洞察。`}
>
  <div class="space-y-6 pb-20">
    <!-- 1. Cinematic Editorial Hero Stage (电影画报大刊头) -->
    <EditorialHero issue={issue} />

    <!-- 2. 今日主理人寄语 (完全展开 · 尊崇杂志排版 · 绝不折叠) -->
    {Content && (
      <section class="relative overflow-hidden rounded-3xl p-6 sm:p-7 bg-gradient-to-br from-zinc-100 via-zinc-50/80 to-white dark:from-[#16181e] dark:via-[#14151a] dark:to-[#0f1115] border border-zinc-200/90 dark:border-zinc-800/80 shadow-sm space-y-4">
        <!-- Masthead Sub-Badge -->
        <div class="flex items-center justify-between border-b border-zinc-200/70 dark:border-zinc-800/70 pb-3">
          <div class="flex items-center gap-2.5">
            <span class="w-8 h-8 rounded-xl bg-indigo-600/10 dark:bg-indigo-500/20 text-indigo-600 dark:text-indigo-400 flex items-center justify-center font-serif font-black text-sm">
              ✍️
            </span>
            <div>
              <h2 class="font-bold text-sm text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
                <span>今日主理人寄语</span>
                <span class="px-2 py-0.5 rounded-full bg-indigo-50 dark:bg-indigo-950/80 text-indigo-600 dark:text-indigo-400 text-[10px] font-mono font-medium border border-indigo-200/60 dark:border-indigo-800/60">
                  岛主声音 · 产品人与故事思维
                </span>
              </h2>
            </div>
          </div>
          <span class="text-xs font-mono text-zinc-400 dark:text-zinc-500">
            {date}
          </span>
        </div>

        <!-- Rendered Markdown Body -->
        <div class="prose prose-sm dark:prose-invert max-w-none text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed space-y-3 [&>h2]:hidden [&>p>strong]:text-indigo-600 dark:[&>p>strong]:text-indigo-400 [&>p>strong]:font-bold">
          <Content />
        </div>
      </section>
    )}

    <!-- 3. Sticky Magazine Category Filter Bar (吸顶分类分栏) -->
    <EditorialCategoryBar totalCount={sortedItems.length} />

    <!-- 4. Cinematic 3-Column Screenplay Cards Feed (电影分镜先锋画报流) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {sortedItems.map((item, idx) => (
        <DailyItemCard item={item} index={idx} />
      ))}
    </div>
  </div>
</DashboardLayout>
