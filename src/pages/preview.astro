  <script is:inline>
    function switchConcept(conceptId) {
      document.getElementById('view-concept1').classList.add('hidden');
      document.getElementById('view-concept2').classList.add('hidden');
      document.getElementById('view-concept4').classList.add('hidden');

      document.getElementById('btn-concept1').className = 'px-3.5 py-2 rounded-xl text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-all';
      document.getElementById('btn-concept2').className = 'px-3.5 py-2 rounded-xl text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-all';
      document.getElementById('btn-concept4').className = 'px-3.5 py-2 rounded-xl text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-all';

      if (conceptId === 'concept1') {
        document.getElementById('view-concept1').classList.remove('hidden');
        document.getElementById('btn-concept1').className = 'px-3.5 py-2 rounded-xl text-xs font-bold transition-all bg-indigo-600 text-white shadow-sm';
      } else if (conceptId === 'concept2') {
        document.getElementById('view-concept2').classList.remove('hidden');
        document.getElementById('btn-concept2').className = 'px-3.5 py-2 rounded-xl text-xs font-bold transition-all bg-indigo-600 text-white shadow-sm';
      } else if (conceptId === 'concept4') {
        document.getElementById('view-concept4').classList.remove('hidden');
        document.getElementById('btn-concept4').className = 'px-3.5 py-2 rounded-xl text-xs font-bold transition-all bg-indigo-600 text-white shadow-sm';
      }
    }
  </script>
