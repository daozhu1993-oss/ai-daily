---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="高清图文与电影视觉布局预览 · 岛主 AI 日报" description="三套独创图文并茂布局真实渲染预览">
  <div class="max-w-5xl mx-auto space-y-6">
    
    <!-- Top Controller / Switcher Header -->
    <div class="bg-white dark:bg-[#17191e] border border-zinc-200/80 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 shadow-sm space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <span class="text-xs font-mono font-bold tracking-wider uppercase text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/60 px-2.5 py-1 rounded-full border border-indigo-200/60 dark:border-indigo-800/40">
            Visual Upgrade · 高清图文与呼吸感
          </span>
          <h1 class="text-2xl sm:text-3xl font-black tracking-tight mt-2 text-zinc-900 dark:text-zinc-50 font-serif">
            岛主 AI 日报 · 沉浸式图文视觉流（摆脱文字压力）
          </h1>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mt-1">
            保留 100% 高清封面图与视觉张力，融合编剧分镜与现代杂志美学，点击切换 3 套充满「呼吸感」的视觉方案：
          </p>
        </div>

        <!-- Concept Switcher Buttons -->
        <div class="flex items-center gap-1.5 p-1.5 bg-zinc-100 dark:bg-zinc-800/80 border border-zinc-200/80 dark:border-zinc-700/80 rounded-2xl shrink-0 self-start sm:self-center">
          <button
            type="button"
            onclick="switchConcept('concept1')"
            id="btn-concept1"
            class="px-3.5 py-2 rounded-xl text-xs font-bold transition-all bg-indigo-600 text-white shadow-sm"
          >
            🎬 方案一：电影画报分镜流
          </button>
          <button
            type="button"
            onclick="switchConcept('concept2')"
            id="btn-concept2"
            class="px-3.5 py-2 rounded-xl text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-all"
          >
            🍱 方案二：视觉 Bento 展厅
          </button>
          <button
            type="button"
            onclick="switchConcept('concept4')"
            id="btn-concept4"
            class="px-3.5 py-2 rounded-xl text-xs font-medium text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-white transition-all"
          >
            ✨ 方案四：旗舰图文双流合一
          </button>
        </div>
      </div>
    </div>

    <!-- ======================================================== -->
    <!-- CONCEPT 1: 电影画报分镜流 (Cinematic Editorial Poster) -->
    <!-- ======================================================== -->
    <div id="view-concept1" class="space-y-6 transition-all duration-300">
      <div class="bg-white dark:bg-[#17191e] border border-zinc-200/80 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 space-y-8 shadow-sm">
        
        <!-- Header Bar -->
        <div class="flex items-center justify-between border-b border-zinc-200/80 dark:border-zinc-800 pb-4">
          <div class="flex items-center gap-3">
            <span class="font-serif italic font-black text-2xl tracking-tight text-indigo-600 dark:text-indigo-400">
              Daozhu's Daily
            </span>
            <span class="text-xs text-zinc-500 border-l border-zinc-300 dark:border-zinc-700 pl-3 hidden sm:inline">
              用故事思维驱动用户价值
            </span>
          </div>
          <div class="flex items-center gap-2 text-xs font-mono">
            <span class="px-2.5 py-1 rounded-md bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-700">9月3日 · 第0903期</span>
            <span class="px-2.5 py-1 rounded-md bg-indigo-50 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-300 font-bold border border-indigo-200/60 dark:border-indigo-800/40">64 篇图文精选</span>
          </div>
        </div>

        <!-- Cinema Hero Feature (电影海报大刊头) -->
        <div class="relative overflow-hidden rounded-3xl border border-zinc-200/80 dark:border-zinc-700 bg-gradient-to-t from-black/90 via-black/40 to-transparent min-h-[320px] sm:min-h-[380px] flex flex-col justify-end p-6 sm:p-8 text-white group shadow-lg">
          <img
            src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=1600&auto=format&fit=crop&q=80"
            alt="Hero Background"
            class="absolute inset-0 w-full h-full object-cover -z-10 group-hover:scale-105 transition-transform duration-700 brightness-75"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent -z-10"></div>

          <div class="space-y-3 max-w-2xl">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-600/90 backdrop-blur-md text-white text-xs font-bold shadow-sm">
              <span>🌟 今日主线特刊</span>
              <span>·</span>
              <span>Gemini 3.8 & ReelShort 破10亿</span>
            </div>
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight font-serif text-white leading-tight">
              极速工作马与盈利短剧：当 AI 从演示走向真正赚钱
            </h2>
            <p class="text-xs sm:text-sm text-zinc-200 leading-relaxed line-clamp-2">
              谷歌上线 Gemini 3.8 Flash 形成玩游戏/找错/改代码完整闭环；ReelShort 全年突破 10 亿美元实现首次盈利。
            </p>

            <!-- 对白剧场胶囊 -->
            <div class="p-3.5 rounded-xl bg-white/10 backdrop-blur-md border border-white/20 text-xs font-mono text-zinc-100 flex items-center gap-2.5">
              <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse shrink-0"></span>
              <span class="italic">🎬 「以前是报错等 AI 猜；现在 Gemini 3.8 自己玩了三关并提 PR 把 Bug 修了。」</span>
            </div>
          </div>
        </div>

        <!-- Sticky Top Category Bar (带色彩小圆点的杂志分栏) -->
        <div class="flex items-center gap-2 overflow-x-auto pb-2 border-b border-zinc-200 dark:border-zinc-800 text-xs no-scrollbar">
          <button class="px-4 py-2 rounded-full bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 font-bold shrink-0 shadow-sm">全部 64</button>
          <button class="px-3.5 py-2 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 font-medium shrink-0 hover:bg-zinc-200 dark:hover:bg-zinc-700 flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-blue-500"></span><span>AI 资讯 10</span></button>
          <button class="px-3.5 py-2 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 font-medium shrink-0 hover:bg-zinc-200 dark:hover:bg-zinc-700 flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-amber-500"></span><span>一人公司 12</span></button>
          <button class="px-3.5 py-2 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 font-medium shrink-0 hover:bg-zinc-200 dark:hover:bg-zinc-700 flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-sky-500"></span><span>产品经理 3</span></button>
          <button class="px-3.5 py-2 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 font-medium shrink-0 hover:bg-zinc-200 dark:hover:bg-zinc-700 flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-emerald-500"></span><span>产品设计 16</span></button>
          <button class="px-3.5 py-2 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 font-medium shrink-0 hover:bg-zinc-200 dark:hover:bg-zinc-700 flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-violet-500"></span><span>编剧技巧 3</span></button>
          <button class="px-3.5 py-2 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 font-medium shrink-0 hover:bg-zinc-200 dark:hover:bg-zinc-700 flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-orange-500"></span><span>AI 漫剧 4</span></button>
        </div>

        <!-- Rich Visual Cards Grid (双列带 16:9 高清封面图) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          
          <!-- Card 1 -->
          <div class="group rounded-2xl overflow-hidden bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200/80 dark:border-zinc-800 hover:border-indigo-500/50 hover:shadow-lg transition-all flex flex-col justify-between">
            <div class="relative aspect-video w-full overflow-hidden bg-zinc-800">
              <img
                src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=800&auto=format&fit=crop&q=80"
                alt="Gemini"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute top-3 left-3 flex items-center gap-1.5">
                <span class="px-2.5 py-1 rounded-full bg-black/70 backdrop-blur-md text-white font-mono font-bold text-[11px]">SCENE #01</span>
                <span class="px-2.5 py-1 rounded-full bg-blue-500/90 backdrop-blur-md text-white font-bold text-[11px]">AI 资讯</span>
              </div>
              <div class="absolute bottom-3 right-3 px-2 py-0.5 rounded bg-black/60 backdrop-blur-md text-white font-mono text-[10px]">
                blog.google
              </div>
            </div>
            
            <div class="p-5 space-y-3 flex-1 flex flex-col justify-between">
              <div class="space-y-2">
                <h3 class="text-base sm:text-lg font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors leading-snug">
                  Gemini 3.8 Flash：同一价位，开始能自己把游戏找错改完
                </h3>
                <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed line-clamp-2">
                  会玩、会找错、会改代码，极速工作马第一次把这三步收成自闭环，Cursor 当天无缝接入。
                </p>
              </div>

              <div class="p-3 rounded-xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200/60 dark:border-amber-800/40 text-xs text-amber-800 dark:text-amber-300 font-medium leading-relaxed">
                💡 <strong>穿透价值</strong>：当工具不仅能写代码，还能自己玩通游戏并修 Bug，它才算接过键盘。
              </div>
            </div>
          </div>

          <!-- Card 2 -->
          <div class="group rounded-2xl overflow-hidden bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200/80 dark:border-zinc-800 hover:border-violet-500/50 hover:shadow-lg transition-all flex flex-col justify-between">
            <div class="relative aspect-video w-full overflow-hidden bg-zinc-800">
              <img
                src="https://images.unsplash.com/photo-1455390582262-044cdead277a?w=800&auto=format&fit=crop&q=80"
                alt="Screenwriting"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute top-3 left-3 flex items-center gap-1.5">
                <span class="px-2.5 py-1 rounded-full bg-black/70 backdrop-blur-md text-white font-mono font-bold text-[11px]">SCENE #02</span>
                <span class="px-2.5 py-1 rounded-full bg-violet-500/90 backdrop-blur-md text-white font-bold text-[11px]">编剧技巧</span>
              </div>
              <div class="absolute bottom-3 right-3 px-2 py-0.5 rounded bg-black/60 backdrop-blur-md text-white font-mono text-[10px]">
                wzbj1616.com
              </div>
            </div>
            
            <div class="p-5 space-y-3 flex-1 flex flex-col justify-between">
              <div class="space-y-2">
                <h3 class="text-base sm:text-lg font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-violet-600 dark:group-hover:text-violet-400 transition-colors leading-snug">
                  新人必看！两种最常见的剧本模式与情节推演公式
                </h3>
                <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed line-clamp-2">
                  经典「救猫咪」英雄之旅与「动机-阻碍-危机-顿悟」逆境结构深度拆解，故事写不下去时的万能解题钥匙。
                </p>
              </div>

              <div class="p-3 rounded-xl bg-violet-50 dark:bg-violet-950/40 border border-violet-200/60 dark:border-violet-800/40 text-xs text-violet-800 dark:text-violet-300 font-medium leading-relaxed">
                💡 <strong>穿透价值</strong>：剧本模式就是思维模型，熟练运用模式让你构思产品时少走 80% 弯路。
              </div>
            </div>
          </div>

          <!-- Card 3 -->
          <div class="group rounded-2xl overflow-hidden bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200/80 dark:border-zinc-800 hover:border-orange-500/50 hover:shadow-lg transition-all flex flex-col justify-between">
            <div class="relative aspect-video w-full overflow-hidden bg-zinc-800">
              <img
                src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=800&auto=format&fit=crop&q=80"
                alt="ReelShort"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute top-3 left-3 flex items-center gap-1.5">
                <span class="px-2.5 py-1 rounded-full bg-black/70 backdrop-blur-md text-white font-mono font-bold text-[11px]">SCENE #03</span>
                <span class="px-2.5 py-1 rounded-full bg-orange-500/90 backdrop-blur-md text-white font-bold text-[11px]">AI 漫剧</span>
              </div>
              <div class="absolute bottom-3 right-3 px-2 py-0.5 rounded bg-black/60 backdrop-blur-md text-white font-mono text-[10px]">
                dramagoing.com
              </div>
            </div>
            
            <div class="p-5 space-y-3 flex-1 flex flex-col justify-between">
              <div class="space-y-2">
                <h3 class="text-base sm:text-lg font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors leading-snug">
                  从烧钱买量到能赚钱：ReelShort 破 10 亿营收，字节搭起短剧操作系统
                </h3>
                <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed line-clamp-2">
                  MPA 预测 ReelShort 年度破 10 亿美金首次盈利，短剧出海从买量换增长全面拐入利润收敛期。
                </p>
              </div>

              <div class="p-3 rounded-xl bg-orange-50 dark:bg-orange-950/40 border border-orange-200/60 dark:border-orange-800/40 text-xs text-orange-800 dark:text-orange-300 font-medium leading-relaxed">
                💡 <strong>穿透价值</strong>：行业走向精细化运营，具备稳定产能与分发矩阵的团队将吃下最肥沃的利润。
              </div>
            </div>
          </div>

          <!-- Card 4 -->
          <div class="group rounded-2xl overflow-hidden bg-zinc-50 dark:bg-zinc-900/60 border border-zinc-200/80 dark:border-zinc-800 hover:border-amber-500/50 hover:shadow-lg transition-all flex flex-col justify-between">
            <div class="relative aspect-video w-full overflow-hidden bg-zinc-800">
              <img
                src="https://images.unsplash.com/photo-1551836022-d5d88e9218df?w=800&auto=format&fit=crop&q=80"
                alt="Solopreneur"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute top-3 left-3 flex items-center gap-1.5">
                <span class="px-2.5 py-1 rounded-full bg-black/70 backdrop-blur-md text-white font-mono font-bold text-[11px]">SCENE #04</span>
                <span class="px-2.5 py-1 rounded-full bg-amber-500/90 backdrop-blur-md text-white font-bold text-[11px]">一人公司</span>
              </div>
              <div class="absolute bottom-3 right-3 px-2 py-0.5 rounded bg-black/60 backdrop-blur-md text-white font-mono text-[10px]">
                playgrnd.tools
              </div>
            </div>
            
            <div class="p-5 space-y-3 flex-1 flex flex-col justify-between">
              <div class="space-y-2">
                <h3 class="text-base sm:text-lg font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-amber-600 dark:group-hover:text-amber-400 transition-colors leading-snug">
                  Playgrnd：不上号、不设墙，三十二件免登录小工具箱
                </h3>
                <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed line-clamp-2">
                  账号和付费墙全拿掉，打开就能做怪东西，新工具按天掉落，极简冷启动示范。
                </p>
              </div>

              <div class="p-3 rounded-xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200/60 dark:border-amber-800/40 text-xs text-amber-800 dark:text-amber-300 font-medium leading-relaxed">
                💡 <strong>穿透价值</strong>：降低使用摩擦力就是最好的增长黑客，先让用户爽到比强行卡点有效十倍。
              </div>
            </div>
          </div>

        </div>

      </div>
    </div>

    <!-- ======================================================== -->
    <!-- CONCEPT 2: 视觉 Bento 展厅 (Visual Bento Gallery) -->
    <!-- ======================================================== -->
    <div id="view-concept2" class="space-y-6 hidden transition-all duration-300">
      <div class="bg-white dark:bg-[#17191e] border border-zinc-200/80 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 space-y-6 shadow-sm">
        
        <div class="flex items-center justify-between border-b border-zinc-200 dark:border-zinc-800 pb-4">
          <div>
            <h2 class="text-xl font-black text-zinc-900 dark:text-zinc-50">视觉 Bento 展厅矩阵</h2>
            <p class="text-xs text-zinc-500 dark:text-zinc-400">高清大图与磨砂半透明卡片结合，现代感十足</p>
          </div>
          <span class="px-2.5 py-1 rounded-full bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 text-xs font-bold font-mono">VISUAL BENTO</span>
        </div>

        <!-- Bento Grid with Images -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          
          <!-- Big Visual Bento (2 cols) -->
          <div class="md:col-span-2 relative rounded-3xl overflow-hidden min-h-[300px] flex flex-col justify-end p-6 text-white group border border-zinc-200/80 dark:border-zinc-800 shadow-md">
            <img
              src="https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=1200&auto=format&fit=crop&q=80"
              alt="Bento Cover"
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 -z-10 brightness-75"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent -z-10"></div>

            <div class="space-y-2">
              <span class="px-2.5 py-1 rounded-full bg-blue-600 text-white text-[11px] font-bold">🤖 今日头条 · AI 资讯</span>
              <h3 class="text-xl sm:text-2xl font-black text-white">
                Gemini 3.8 Flash：极速自闭环工作马突发上线
              </h3>
              <p class="text-xs text-zinc-200 line-clamp-2">
                玩游戏、查错并自动改代码提 PR，Cursor 当天无缝接入。
              </p>
              <div class="text-xs text-amber-300 font-medium pt-2 border-t border-white/20">
                💡 穿透价值：它才算真正接过了键盘。
              </div>
            </div>
          </div>

          <!-- Bento 2: 编剧与短剧高光 (1 col) -->
          <div class="relative rounded-3xl overflow-hidden min-h-[300px] flex flex-col justify-end p-5 text-white group border border-zinc-200/80 dark:border-zinc-800 shadow-md">
            <img
              src="https://images.unsplash.com/photo-1485846234645-a62644f84728?w=800&auto=format&fit=crop&q=80"
              alt="Bento Cover 2"
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 -z-10 brightness-75"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent -z-10"></div>

            <div class="space-y-2">
              <span class="px-2.5 py-1 rounded-full bg-violet-600 text-white text-[11px] font-bold">🎬 编剧技巧</span>
              <h4 class="text-base font-bold text-white">两种最常见剧本模式与推演公式</h4>
              <p class="text-xs text-zinc-200 line-clamp-2">英雄之旅与逆境模型，在产品流程中的情绪应用。</p>
            </div>
          </div>

        </div>

      </div>
    </div>

    <!-- ======================================================== -->
    <!-- CONCEPT 4: 旗舰图文双流合一 (Visual Flagship Hybrid) -->
    <!-- ======================================================== -->
    <div id="view-concept4" class="space-y-6 hidden transition-all duration-300">
      <div class="bg-white dark:bg-[#17191e] border border-zinc-200/80 dark:border-zinc-800 rounded-3xl p-6 sm:p-8 space-y-6 shadow-sm">
        
        <div class="flex items-center justify-between border-b border-zinc-200 dark:border-zinc-800 pb-4">
          <div class="flex items-center gap-3">
            <span class="font-serif italic font-black text-2xl tracking-tight text-indigo-600 dark:text-indigo-400">
              Daozhu's Daily
            </span>
            <span class="text-xs px-2.5 py-0.5 rounded-full bg-indigo-50 dark:bg-indigo-950/60 text-indigo-600 dark:text-indigo-400 font-bold border border-indigo-200/60 dark:border-indigo-800/40">
              旗舰图文融合流
            </span>
          </div>
          <span class="text-xs font-mono text-zinc-400">9大领域 · 呼吸感排版</span>
        </div>

        <!-- Cinema Hero + Side Quick Nav -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          
          <!-- Left 2 Cols: 海报大刊头 -->
