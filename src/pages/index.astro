---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import DailyItemCard from '../components/DailyItemCard.astro';
import EditorialHero from '../components/EditorialHero.astro';
import EditorialCategoryBar from '../components/EditorialCategoryBar.astro';
import { getCollection, render } from 'astro:content';
import { siteConfig } from '../config/site';

// Fetch all published issues sorted by date descending
const allDailies = await getCollection('daily', ({ data }) => !data.draft);

const sortedDailies = allDailies.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const latestDaily = sortedDailies[0];

// Render Markdown body of the issue if present
let LatestContent = null;
if (latestDaily) {
  const rendered = await render(latestDaily);
  LatestContent = rendered.Content;
}

// Sort items: pinned first
const items = latestDaily
  ? [...latestDaily.data.items].sort((a, b) => {
      if (a.pinned && !b.pinned) return -1;
      if (!a.pinned && b.pinned) return 1;
      return 0;
    })
  : [];
---

{
  latestDaily ? (
    <DashboardLayout
      currentIssue={latestDaily}
      allIssues={sortedDailies}
      showRightSidebar={false}
      title={`${latestDaily.data.title || `${latestDaily.data.date} · 今日看点`} - ${siteConfig.name}`}
      description={latestDaily.data.highlights || siteConfig.description}
    >
      <div class="space-y-8 pb-20">
        <!-- 1. Cinematic Editorial Hero Stage (电影画报大刊头) -->
        <EditorialHero issue={latestDaily} />

        <!-- 2. Sticky Magazine Category Filter Bar (吸顶分类分栏) -->
        <EditorialCategoryBar totalCount={items.length} />

        <!-- Optional Editor's Markdown Note if present -->
        {LatestContent && (
          <div class="p-5 rounded-2xl bg-zinc-100/80 dark:bg-zinc-900/60 border border-zinc-200/80 dark:border-zinc-800/80 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
            <LatestContent />
          </div>
        )}

        <!-- 3. Cinematic 2-Column Screenplay Cards Feed (电影分镜画报流) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {items.map((item, idx) => (
            <DailyItemCard item={item} index={idx} />
          ))}
        </div>
      </div>
    </DashboardLayout>
  ) : (
    <div class="min-h-screen flex items-center justify-center text-zinc-400 text-sm">
      暂无发布的日报内容
    </div>
  )
}
