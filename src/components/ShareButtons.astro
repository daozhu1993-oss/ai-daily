---
import { siteConfig } from '../config/site';

interface Props {
  title: string;
  url?: string;
}

const { title, url } = Astro.props;

if (!siteConfig.features.sharing.enabled) {
  return null;
}
---

<div class="flex items-center gap-2 flex-wrap text-xs font-medium share-container">
  <span class="text-zinc-400 dark:text-zinc-500 mr-1">分享本期:</span>

  <!-- Copy Link Button -->
  <button
    type="button"
    class="copy-link-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#17191e] hover:bg-zinc-50 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500/40"
    data-title={title}
    data-url={url}
  >
    <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
    </svg>
    <span class="copy-text">复制链接</span>
  </button>

  <!-- Native Share (Web Share API for Mobile) -->
  <button
    type="button"
    class="native-share-btn hidden inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#17191e] hover:bg-zinc-50 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 transition-colors focus:outline-none focus:ring-2 focus:ring-indigo-500/40"
    data-title={title}
    data-url={url}
  >
    <svg class="w-3.5 h-3.5 text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
    </svg>
    <span>系统分享</span>
  </button>

  <!-- Share to X -->
  <a
    href={`https://x.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url || siteConfig.url)}`}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#17191e] hover:bg-zinc-50 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 transition-colors"
  >
    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
    </svg>
    <span>分享到 X</span>
  </a>
</div>

<script is:inline>
  (function () {
    const initShareButtons = () => {
      // Check Web Share API support
      if (typeof navigator !== 'undefined' && navigator.share) {
        document.querySelectorAll('.native-share-btn').forEach((btn) => {
          btn.classList.remove('hidden');
          btn.addEventListener('click', async () => {
            const title = btn.getAttribute('data-title') || document.title;
            const url = btn.getAttribute('data-url') || window.location.href;
            try {
              await navigator.share({ title, url });
            } catch (err) {
              // User cancelled share
            }
          });
        });
      }

      // Copy link buttons
      document.querySelectorAll('.copy-link-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const url = btn.getAttribute('data-url') || window.location.href;
          const textSpan = btn.querySelector('.copy-text');
          try {
            await navigator.clipboard.writeText(url);
            if (textSpan) {
              const original = textSpan.textContent;
              textSpan.textContent = '已复制！';
              btn.classList.add('text-indigo-600', 'border-indigo-300');
              setTimeout(() => {
                textSpan.textContent = original;
                btn.classList.remove('text-indigo-600', 'border-indigo-300');
              }, 2000);
            }
          } catch (e) {
            // fallback
          }
        });
      });
    };

    initShareButtons();
    document.addEventListener('astro:page-load', initShareButtons);
  })();
</script>
