---
import { getCategoryByKey } from '../config/categories';

interface Props {
  item: {
    category: string;
    title: string;
    note: string;
    url: string;
    source: string;
    media?: string;
    pinned?: boolean;
    so_what?: string;
  };
  index?: number;
}

const { item } = Astro.props;
const catMeta = getCategoryByKey(item.category);

// Extract clean hostname for meta display (e.g. "anthropic.com")
let hostname = item.source;
try {
  const urlObj = new URL(item.url);
  hostname = urlObj.hostname.replace(/^www\./, '');
} catch (e) {
  // fallback to item.source
}
---

<div
  class="daily-item-card-wrapper h-full flex flex-col cursor-pointer"
  data-category={item.category}
  data-title={item.title}
  data-note={item.note}
  data-sowhat={item.so_what || ''}
  data-source={hostname}
  data-url={item.url}
  data-media={item.media || ''}
>
  <article
    class={`open-reader-trigger group relative flex flex-col h-full rounded-2xl bg-white dark:bg-[#17191e] border transition-all duration-200 overflow-hidden ${
      item.pinned
        ? 'border-indigo-300 dark:border-indigo-700/80 shadow-md shadow-indigo-500/5'
        : 'border-zinc-200/80 dark:border-zinc-800/80 hover:border-indigo-300 dark:hover:border-indigo-800/80 hover:shadow-md hover:shadow-black/5'
    }`}
  >
    <!-- Card Media / Screenshot Preview Header -->
    {
      item.media ? (
        <div class="block relative aspect-[16/10] overflow-hidden bg-zinc-100 dark:bg-zinc-900 border-b border-zinc-100 dark:border-zinc-800/60">
          <img
            src={item.media}
            alt={item.title}
            loading="lazy"
            class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
          />
        </div>
      ) : (
        /* Subtle aesthetic header for text-only cards */
        <div class="h-2 w-full bg-gradient-to-r from-transparent via-zinc-200/40 dark:via-zinc-800/60 to-transparent" />
      )
    }

    <!-- Card Content -->
    <div class="p-5 flex flex-col flex-1 justify-between gap-3">
      <div class="space-y-2.5">
        <!-- Category & Source Meta Row -->
        <div class="flex items-center justify-between gap-2 text-xs text-zinc-400 dark:text-zinc-500">
          <div class="flex items-center gap-1.5 font-medium">
            <span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-semibold ${catMeta.color.bg} ${catMeta.color.text} ${catMeta.color.darkBg} ${catMeta.color.darkText}`}>
              <span class={`w-1 h-1 rounded-full ${catMeta.color.dot}`}></span>
              <span>{item.category}</span>
            </span>
            <span class="text-zinc-300 dark:text-zinc-700">·</span>
            <span class="font-mono text-[11px] truncate max-w-[130px]">{hostname}</span>
          </div>

          {item.pinned && (
            <span class="px-1.5 py-0.2 rounded text-[10px] font-semibold bg-indigo-50 dark:bg-indigo-950/60 text-indigo-700 dark:text-indigo-300">
              置顶
            </span>
          )}
        </div>

        <!-- Title -->
        <h3 class="font-bold text-sm sm:text-base text-zinc-900 dark:text-zinc-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors leading-snug">
          {item.title}
        </h3>

        <!-- Sharp Commentary -->
        <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed line-clamp-3">
          {item.note}
        </p>
      </div>

      <!-- Footer: So What & External Direct Button -->
      <div class="pt-2 border-t border-zinc-100 dark:border-zinc-800/60 flex items-center justify-between gap-2">
        {item.so_what ? (
          <div class="text-[11px] text-indigo-700 dark:text-indigo-300 bg-indigo-50/70 dark:bg-indigo-950/40 px-2 py-1 rounded-md border border-indigo-100/60 dark:border-indigo-900/30 truncate flex-1">
            💡 {item.so_what}
          </div>
        ) : (
          <div class="text-[11px] text-zinc-400 font-mono">
            来源：{item.source}
          </div>
        )}

        <a
          href={item.url}
          target="_blank"
          rel="noopener noreferrer"
          title={`在新标签页打开官方原文 (${hostname})`}
          aria-label={`查看 ${item.title} 原文`}
          class="direct-external-btn w-7 h-7 rounded-full bg-zinc-100 dark:bg-zinc-800 hover:bg-indigo-600 hover:text-white dark:hover:bg-indigo-600 dark:hover:text-white text-zinc-600 dark:text-zinc-300 flex items-center justify-center transition-all shrink-0 text-xs font-bold shadow-sm"
        >
          ↗
        </a>
      </div>
    </div>
  </article>
</div>
