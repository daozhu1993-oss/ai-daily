---
import type { CollectionEntry } from 'astro:content';
import { getCategoryByKey } from '../config/categories';

interface Props {
  issue: CollectionEntry<'daily'>;
}

const { issue } = Astro.props;
const { date, title, highlights, items } = issue.data;
const displayTitle = title || `${date} · 今日看点`;
const uniqueCategories = Array.from(new Set(items.map((i) => i.category)));
---

<a
  href={`/d/${date}`}
  class="group block p-5 sm:p-6 rounded-2xl bg-white dark:bg-[#17191e] border border-zinc-200/80 dark:border-zinc-800/80 hover:border-indigo-400 dark:hover:border-indigo-600/70 hover:shadow-md hover:shadow-indigo-500/5 transition-all duration-200"
>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
    <!-- Date & Item Count -->
    <div class="flex items-center gap-2.5">
      <time class="text-xs font-semibold text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/60 px-2.5 py-1 rounded-md font-mono">
        {date}
      </time>
      <span class="text-xs text-zinc-400 dark:text-zinc-500">
        共 {items.length} 条精选
      </span>
    </div>

    <!-- Category Pills -->
    <div class="flex items-center gap-1.5 flex-wrap">
      {
        uniqueCategories.slice(0, 4).map((cat) => {
          const catMeta = getCategoryByKey(cat);
          return (
            <span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-medium ${catMeta.color.bg} ${catMeta.color.text} ${catMeta.color.darkBg} ${catMeta.color.darkText}`}>
              <span class={`w-1 h-1 rounded-full ${catMeta.color.dot}`}></span>
              <span>{cat}</span>
            </span>
          );
        })
      }
      {
        uniqueCategories.length > 4 && (
          <span class="text-[11px] text-zinc-400 dark:text-zinc-500">
            +{uniqueCategories.length - 4}
          </span>
        )
      }
    </div>
  </div>

  <!-- Title -->
  <h3 class="text-base sm:text-lg font-bold text-zinc-900 dark:text-zinc-100 group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors mb-2">
    {displayTitle}
  </h3>

  <!-- Highlights -->
  {
    highlights && (
      <p class="text-sm text-zinc-600 dark:text-zinc-400 line-clamp-2 leading-relaxed mb-4">
        {highlights}
      </p>
    )
  }

  <!-- Footer Link -->
  <div class="flex items-center text-xs font-medium text-indigo-600 dark:text-indigo-400 group-hover:translate-x-0.5 transition-transform">
    <span>阅读当期完整内容</span>
    <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
    </svg>
  </div>
</a>
