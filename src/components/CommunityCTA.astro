---
import { siteConfig } from '../config/site';

const { community } = siteConfig.features;

if (!community.enabled) {
  return null;
}
---

<div class="relative overflow-hidden rounded-2xl border border-zinc-200/80 dark:border-zinc-800 bg-white dark:bg-[#17191e] p-6 sm:p-7 shadow-sm">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="space-y-1.5 max-w-lg">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200/60 dark:border-emerald-800/40">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>{community.tag}</span>
      </div>
      <h3 class="text-base sm:text-lg font-bold text-zinc-900 dark:text-zinc-50">
        {community.title}
      </h3>
      <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">
        {community.description}
      </p>
    </div>

    <a
      href={community.link}
      class="inline-flex items-center justify-center gap-1.5 px-5 py-2.5 rounded-xl text-sm font-semibold text-zinc-900 dark:text-white bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors shrink-0 shadow-sm"
    >
      <span>{community.buttonText}</span>
      <svg class="w-4 h-4 text-zinc-500 dark:text-zinc-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </a>
  </div>
</div>
